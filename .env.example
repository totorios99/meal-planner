# Copy to .env (gitignored) for local dev.

DATABASE_URL=file:./db/meal-planner.db

# --- Clerk (user authentication) ---------------------------------------------
# From dashboard.clerk.com → your app → API keys.
# NEXT_PUBLIC_* are compiled into the browser bundle by design. CLERK_SECRET_KEY is not,
# and must never be given a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# --- Admin / agent access ----------------------------------------------------
# Server-only. Sent by the MCP server as the `x-mise-admin-secret` header — header only,
# never a query string, never from browser code. Unset = agent access disabled, not open.
# Generate with: openssl rand -hex 32
MISE_ADMIN_SECRET=

# The Clerk user id (user_...) that agent imports create rows for, and that the multi_user
# migration backfills pre-existing rows to. Find it in the Clerk dashboard under Users.
MISE_OWNER_USER_ID=
