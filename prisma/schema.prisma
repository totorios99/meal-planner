// This is your Prisma schema file

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Meal {
  id          Int    @id @default(autoincrement())
  title       String
  description String @default("")
  tag         String @default("")
  calories    Float
  protein     Float
  carbs       Float
  fats        Float
  imageUrl    String @default("")
  ingredients String @default("[]") // JSON Ingredient[] — see lib/recipe.ts; macros below are the cached sum
  steps       String @default("[]") // JSON string[]
  prepMinutes Int    @default(0)
  cookMinutes Int    @default(0)
  servings    Int    @default(1)
  isFavorite  Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  weeklyPlanMeals WeeklyPlanMeal[]
}

model WeeklyPlan {
  id         Int       @id @default(autoincrement())
  weekStart  DateTime
  isActive   Boolean   @default(false)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())

  days WeeklyPlanDay[]
}

model WeeklyPlanDay {
  id            Int        @id @default(autoincrement())
  weeklyPlanId  Int
  weeklyPlan    WeeklyPlan @relation(fields: [weeklyPlanId], references: [id], onDelete: Cascade)
  dayIndex      Int
  isDismissed   Boolean    @default(false)
  justification String     @default("")

  meals WeeklyPlanMeal[]

  @@unique([weeklyPlanId, dayIndex])
}

model WeeklyPlanMeal {
  id              Int           @id @default(autoincrement())
  weeklyPlanDayId Int
  weeklyPlanDay   WeeklyPlanDay @relation(fields: [weeklyPlanDayId], references: [id], onDelete: Cascade)
  mealId          Int
  meal            Meal          @relation(fields: [mealId], references: [id])
  slotIndex       Int
  ingredients     String        @default("[]") // JSON Ingredient[] — per-placement snapshot, edited independently of the Meal
}

// Personal ingredient library — pick-list that prefills macros; seeds a future food DB.
// Macros are per 1 unit; line-items copy per-unit × quantity, so editing the library never
// mutates existing recipe/placement snapshots (no FK back here by design).
model Ingredient {
  id        Int      @id @default(autoincrement())
  name      String
  unit      String   @default("")
  calories  Float    @default(0)
  protein   Float    @default(0)
  carbs     Float    @default(0)
  fats      Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, unit])
}
