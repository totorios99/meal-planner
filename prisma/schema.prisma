// This is your Prisma schema file

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Meal {
  id          Int    @id @default(autoincrement())
  title       String
  description String @default("")
  tag         String @default("")
  calories    Float
  protein     Float
  carbs       Float
  fats        Float
  imageUrl    String @default("")
  ingredients String @default("[]") // JSON Ingredient[] — see lib/recipe.ts; macros below are the cached sum
  steps       String @default("[]") // JSON string[]
  prepMinutes Int    @default(0)
  cookMinutes Int    @default(0)
  servings    Int    @default(1)
  isFavorite  Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  weeklyPlanMeals WeeklyPlanMeal[]
}

model WeeklyPlan {
  id         Int       @id @default(autoincrement())
  weekStart  DateTime
  isActive   Boolean   @default(false)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())

  days WeeklyPlanDay[]
}

model WeeklyPlanDay {
  id            Int        @id @default(autoincrement())
  weeklyPlanId  Int
  weeklyPlan    WeeklyPlan @relation(fields: [weeklyPlanId], references: [id], onDelete: Cascade)
  dayIndex      Int
  isDismissed   Boolean    @default(false)
  justification String     @default("")

  meals WeeklyPlanMeal[]

  @@unique([weeklyPlanId, dayIndex])
}

model WeeklyPlanMeal {
  id              Int           @id @default(autoincrement())
  weeklyPlanDayId Int
  weeklyPlanDay   WeeklyPlanDay @relation(fields: [weeklyPlanDayId], references: [id], onDelete: Cascade)
  mealId          Int
  meal            Meal          @relation(fields: [mealId], references: [id])
  slotIndex       Int
  ingredients     String        @default("[]") // JSON IngredientRef[] {foodId,quantity,measure} — per-placement, edited independently
}

// Food source of truth. Macros are per 1 baseUnit; measures give conversion factors
// (perBase = base units in 1 of that measure, e.g. rice cup -> 185 g). Meals reference
// foods by id, so correcting a food propagates to every meal/plan that uses it.
model Food {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  baseUnit  String   @default("")
  calories  Float    @default(0)
  protein   Float    @default(0)
  carbs     Float    @default(0)
  fats      Float    @default(0)
  measures  String   @default("[]") // JSON [{unit, perBase}]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
