// This is your Prisma schema file

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// One preferences row per Clerk user. userId is the primary key — the old singleton `id`
// column is gone, since its `DEFAULT 1` would have collided the moment a second user saved
// a preference.
model Settings {
  userId            String   @id
  calories          Float    @default(2450)
  protein           Float    @default(160)
  carbs             Float    @default(270)
  fats              Float    @default(80)
  recipeView        String   @default("chart")  // 'chart' | 'list'
  units             String   @default("US")     // 'US' | 'Metric'
  theme             String   @default("system") // 'system' | 'light' | 'dark'
  plannerFullTitles Boolean  @default(false)
  weekStartsOn      Int      @default(1)        // 0 = Sunday, 1 = Monday
  updatedAt         DateTime @updatedAt
}

model Meal {
  id          Int    @id @default(autoincrement())
  userId      String // Clerk user id — every query must scope on this, see lib/auth.ts
  title       String
  description String @default("")
  tag         String @default("")
  calories    Float
  protein     Float
  carbs       Float
  fats        Float
  imageUrl    String @default("")
  ingredients String @default("[]") // JSON Ingredient[] — see lib/recipe.ts; macros below are the cached sum
  steps       String @default("[]") // JSON string[]
  stages      String @default("[]") // JSON Stage[] — see lib/recipe.ts; cook-mode chart (ingredient range + slot + timer)
  prepMinutes Int    @default(0)
  cookMinutes Int    @default(0)
  servings    Int    @default(1)
  isFavorite  Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  weeklyPlanMeals WeeklyPlanMeal[]

  @@index([userId])
}

model WeeklyPlan {
  id         Int       @id @default(autoincrement())
  userId     String
  weekStart  DateTime
  isActive   Boolean   @default(false)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())

  days WeeklyPlanDay[]

  @@index([userId])
}

// WeeklyPlanDay and WeeklyPlanMeal carry no userId — they inherit ownership through the
// cascading parent. Scope them by filtering on the parent's userId (see assertOwns in
// lib/auth.ts) so an id guessed from someone else's plan misses.

model WeeklyPlanDay {
  id            Int        @id @default(autoincrement())
  weeklyPlanId  Int
  weeklyPlan    WeeklyPlan @relation(fields: [weeklyPlanId], references: [id], onDelete: Cascade)
  dayIndex      Int
  isDismissed   Boolean    @default(false)
  justification String     @default("")

  meals WeeklyPlanMeal[]

  @@unique([weeklyPlanId, dayIndex])
}

model WeeklyPlanMeal {
  id              Int           @id @default(autoincrement())
  weeklyPlanDayId Int
  weeklyPlanDay   WeeklyPlanDay @relation(fields: [weeklyPlanDayId], references: [id], onDelete: Cascade)
  mealId          Int
  meal            Meal          @relation(fields: [mealId], references: [id])
  slotIndex       Int
  ingredients     String        @default("[]") // JSON IngredientRef[] {foodId,quantity,measure} — per-placement, edited independently
}

// Food source of truth. Nutrients are per 1 baseUnit, sparse/dynamic (see lib/recipe.ts
// NutrientEntry — canonical keys calories/protein_g/carbs_g/fat_g plus any micros/compounds).
// measures give conversion factors (perBase = base units in 1 of that measure, e.g. rice
// cup -> 185 g). Meals reference foods by id, so correcting a food propagates everywhere.
model Food {
  id            Int      @id @default(autoincrement())
  userId        String
  name          String
  baseUnit      String   @default("")
  nutrients     String   @default("[]") // JSON NutrientEntry[]
  measures      String   @default("[]") // JSON [{unit, perBase}]
  imageUrl      String   @default("")
  // A stand-in for "whatever the user actually has" (e.g. "vegetables", "fruit") rather than a
  // real food — contributes 0 to every meal's macros regardless of quantity, and any placement
  // referencing it surfaces a warning asking the user to swap in a specific ingredient.
  isPlaceholder Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, name])
}
